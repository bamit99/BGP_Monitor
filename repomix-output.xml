        self.config_paths = [
            Path('E:/BGP_Monitor/config'),
            Path('C:/BGP_Monitor/config'),
            Path(os.path.expanduser('~/BGP_Monitor/config')),
            Path('D:/ClaudeProjects/bgp_monitor/config')
        ]
        
    def save_db_config(self, uri, username, password):
