{
    "logging": {
        "level": "INFO",
        "syslog": {
            "enabled": true,
            "host": "192.168.0.5",
            "port": 514,
            "protocol": "UDP"
        }
    },
    "security_analysis": {
        "heuristics": {
            "long_path": {
                "enabled": true,
                "threshold": 30,
                "severity": "LOW"
            },
            "prepending": {
                "enabled": true,
                "threshold": 5,
                "severity": "LOW"
            },
            "more_specific": {
                "enabled": true,
                "prefix_length_diff": 4,
                "severity": "MEDIUM"
            },
            "ml_anomaly": {
                "enabled": true,
                "severity": "MEDIUM"
            }
        }
    },
    "notifications": {
        "email": {
            "enabled": false,
            "smtp_host": "smtp.example.com",
            "smtp_port": 587,
            "smtp_user": "",
            "smtp_password": "",
            "use_tls": true,
            "sender_email": "bgp-monitor@example.com",
            "recipient_emails": [
                "admin@example.com"
            ],
            "min_email_severity": "MEDIUM"
        }
    }
}
