# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text diff=python
*.pyw text diff=python

# Documents
*.md text diff=markdown
*.txt text
*.rst text
*.json text

# Graphics
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.svg text

# Python binary files
*.db binary
*.p binary
*.pkl binary
*.pyc binary
*.pyd binary
*.pyo binary

# Make sure Windows batch files preserve CR/LF line endings
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf

# Git config
.gitattributes text
.gitignore text
.gitconfig text
