# Copy to .env and fill in. NEVER commit .env.

# Neo4j password (required)
NEO4J_PASSWORD=change-me

# Prefixes your organisation originates — the baseline for hijack/visibility alerts.
# Space- or comma-separated CIDRs. Leave empty to run in observe-only mode.
BGPMON_OWNED_PREFIXES=

# RIPE RIS collectors (RRCs only; Route Views ids are not valid for RIS Live).
BGPMON_COLLECTORS=rrc00,rrc01,rrc11,rrc12

# Optional API bearer token. Empty = no auth (bind to localhost only).
BGPMON_API_TOKEN=

# Optional syslog/SIEM forwarding
BGPMON_SYSLOG_ENABLED=false
BGPMON_SYSLOG_HOST=

BGPMON_LOG_LEVEL=INFO
